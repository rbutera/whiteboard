          },
          {
            "name": "tags",
            "description": "many strings",
            "type": "string",
            "required": false,
            "many": true
          },
          {
            "name": "children",
            "description": "child elements",
            "type": "element",
            "required": false,
            "many": true
          }
        ]
      }
    ]
  },
  "input": {
    "ops": [
      {
        "op": "create",
        "op_id": "o1",
