{
  "schema": {
    "kinds": [
      {
        "id": "note",
        "description": "a sticky note",
        "attributes": [
          { "name": "text", "description": "the note body", "type": "string", "required": false }
        ]
      }
    ]
  },
  "batches": [
    {
      "actor": "alice",
      "ops": [
        {
          "op": "create",
          "op_id": "o1",
          "element": { "id": "x", "kind": "note", "data": { "text": "kept" } }
        }
      ],
      "expect": "accept"
    },
    {
      "actor": "alice",
      "ops": [
        {
          "op": "create",
          "op_id": "o2",
          "element": { "id": "y", "kind": "note", "data": { "text": "never appended" } }
        },
        { "op": "update", "op_id": "o3", "id": "ghost", "data": { "text": "no such element" } }
      ],
      "expect": { "reject": "unknown-element" }
    }
  ],
  "expect": {
    "state": {
      "x": { "id": "x", "kind": "note", "data": { "text": "kept" } }
    },
    "events": [
      {
        "seq": 1,
        "actor": "alice",
        "op": {
          "op": "create",
          "op_id": "o1",
          "element": { "id": "x", "kind": "note", "data": { "text": "kept" } }
        }
      }
    ]
  }
}
