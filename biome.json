{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}",
      "!**/node_modules",
      "!**/dist",
      "!**/.nx",
      "!**/.venv",
      "!**/.pytest_cache",
      "!**/.mypy_cache",
      "!**/.ruff_cache"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
