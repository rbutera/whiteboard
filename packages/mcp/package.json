{
  "name": "@wboard/mcp",
  "version": "0.1.0-alpha.2",
  "description": "Stateless MCP facade for the whiteboard protocol: the board tools over any board service, plus the wboard-mcp stdio binary and WebSocket push.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbutera/whiteboard.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/rbutera/whiteboard#readme",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "wboard-mcp": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.0.0",
    "@wboard/core": "0.1.0-alpha.2",
    "@wboard/server": "0.1.0-alpha.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "zod": "^4.4.3"
  }
}
